# Copy this file to admin-cli/.env and fill in the real values. Never commit .env.
# Get SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the Supabase dashboard (Project Settings -> API).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE-THE-SERVICE-ROLE-KEY-HERE

PORT=3001
NODE_ENV=development
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# Admin panel login. ADMIN_PASSWORD_HASH is made with: node admin-cli/set-password.js
ADMIN_NAME=Your Name
ADMIN_PASSWORD_HASH=