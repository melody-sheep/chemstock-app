{
  "expo": {
    "name": "chemstock-mobile",
    "slug": "chemstock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "ChemStock needs camera access to capture shipment proof photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChemStock needs your location to record where stock was received."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ChemStock needs access to your photos to save generated QR codes.",
          "savePhotosPermission": "ChemStock needs permission to save generated QR codes to your photos.",
          "granularPermissions": ["photo"]
        }
      ]
    ]
  }
}